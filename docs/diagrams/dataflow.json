  "cards": [
    {
      "dot": "rose",
      "title": "Sensitive data",
      "items": [
        "Call audio is transcribed and discarded; only the transcript and a timing trace are stored",
        "Phone numbers and names live in the calls and records store",
        "A hospital login reads only its own facility; a doctor login only its own patients"
      ]
    },
    {
      "dot": "emerald",
      "title": "Safety path",
      "items": [
        "Every utterance passes the safety gate before the model sees it",
        "Emergency or symptom text gets a fixed reply and a handoff; the model is never asked",
        "The same gate protects the written chat in the patient app"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reads the diagram leaves out",
      "items": [
        "The API reads reference data and bookings to answer; reads are shown as the outputs they feed",
        "The admin console derives fees from partners and arrivals: Rs 2,999 a month and Rs 40 per arrival",
        "Reference data is loaded in batches, never written by a patient request"
      ]
    }
  ]
