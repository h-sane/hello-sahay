  "cards": [
    {
      "dot": "emerald",
      "title": "Helpline path",
      "items": [
        "Phone call to Exotel, then wss through Caddy to the phone bridge, then one CallSession",
        "With lang=auto Sarvam hears every language and speaks Tamil; Polly speaks English and Hindi",
        "The model acts only through tool calls to the same API the apps use, so a booking shows on the Desk live"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety and grounding",
      "items": [
        "The gate runs on every utterance before the model, on calls and in /chat",
        "Answers come from the cited local corpus first, then official government sites only",
        "Medicine matching is a fixed program; the model only reads the label"
      ]
    },
    {
      "dot": "amber",
      "title": "Demo wiring, honestly",
      "items": [
        "One demo hospital, Sunrise Nursing Home, receives every booking and call",
        "WhatsApp confirmation is a log stub; the Care plan payment is a demo, not Razorpay",
        "Patient sign-in code is shown on screen because India SMS needs DLT registration"
      ]
    }
  ]
}