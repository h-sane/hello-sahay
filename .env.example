# Copy to .env and fill in. Never commit .env.

# Database (docker compose up -d)
DATABASE_URL=postgresql+psycopg2://sahay:sahay@localhost:5433/sahay

# AWS — Hussain's PERSONAL account only (never the Nirmaan account)
AWS_PROFILE=personal-bedrock
AWS_REGION=ap-south-1
# Claude models need a card on the account (Marketplace); Nova works on credits.
BEDROCK_FAST_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_SMART_MODEL_ID=apac.amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Tamil text-to-speech (Polly has no Tamil)
SARVAM_API_KEY=

# Demo emergency desk: a teammate phone for the in-call emergency transfer. Never 108/112.
DEMO_EMERGENCY_NUMBER=
# Number every hospital's Call button dials in the patient app (demo only; falls back to DEMO_EMERGENCY_NUMBER).
DEMO_CALL_NUMBER=

# WhatsApp Cloud API (Meta test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auth
JWT_SECRET=change-me
# 1 = the sign-in code is returned to the app and shown on screen (no SMS route yet). 0 once SMS/WhatsApp delivery exists.
OTP_SHOW_CODE=1

# Voice service and web apps call the API here
API_BASE_URL=http://localhost:8001/api/v1
