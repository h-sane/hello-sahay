# APP_HOST / DESK_HOST are <ip>.sslip.io style names; Caddy gets real HTTPS certificates for them.
{$APP_HOST} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8001
	}
	handle_path /voice/* {
		reverse_proxy voice:8002
	}
	@phone path /exotel* /incoming /media
	handle @phone {
		reverse_proxy bridge:8000
	}
	handle {
		root * /srv/patient
		try_files {path} /index.html
		file_server
	}
}

{$DESK_HOST} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8001
	}
	handle {
		root * /srv/desk
		try_files {path} /index.html
		file_server
	}
}
