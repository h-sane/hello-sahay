# *_HOST are <ip>.sslip.io style names and *_NAME the readable ones (sahay., sahaydesk., hellosahay. in front of the same
# <ip>.sslip.io); Caddy gets real HTTPS certificates for all of them. The old names keep working.
{$APP_HOST}, {$APP_NAME:sahay.invalid} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8001
	}
	handle_path /voice/* {
		reverse_proxy voice:8002
	}
	@phone path /exotel* /incoming /media
	handle @phone {
		reverse_proxy bridge:8000
	}
	handle {
		root * /srv/patient
		try_files {path} /index.html
		file_server
	}
}

{$DESK_HOST}, {$DESK_NAME:sahaydesk.invalid} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8001
	}
	handle {
		root * /srv/desk
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_HOST:admin.invalid}, {$ADMIN_NAME:hellosahay.invalid} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8001
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
